{
  "version": 8,
  "name": "Pontual dark (Protomaps schema)",
  "metadata": {
    "pontual:schema": "protomaps-basemap-v4",
    "pontual:licenses": "Map data (c) OpenStreetMap contributors (ODbL). Style: CC0, no third-party hosts."
  },
  "glyphs": "fonts/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://{PMTILES_URL}",
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0A1110" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#0E1614" }
    },
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["forest", "wood", "scrub"]]],
      "paint": { "fill-color": "#12241B", "fill-opacity": 0.95 }
    },
    {
      "id": "landcover-farm",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["farmland", "grassland", "barren"]]],
      "paint": { "fill-color": "#141C14", "fill-opacity": 0.95 }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["park", "garden", "playground", "pitch", "recreation_ground", "stadium", "university", "school", "college", "hospital"]]],
      "paint": { "fill-color": "#14261C", "fill-opacity": 0.95 }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["residential", "commercial", "industrial", "retail"]]],
      "paint": { "fill-color": "#101915" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#14343E" }
    },
    {
      "id": "roads-path",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": ["==", ["get", "kind"], "path"],
      "paint": {
        "line-color": "#33463E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.8, 16, 2],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "roads-minor-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["==", ["get", "kind"], "minor_road"],
      "paint": {
        "line-color": "#1E2B26",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 7]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["==", ["get", "kind"], "minor_road"],
      "paint": {
        "line-color": "#2E4038",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 5.5]
      }
    },
    {
      "id": "roads-major-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["==", ["get", "kind"], "major_road"],
      "paint": {
        "line-color": "#223128",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 16, 11]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["==", ["get", "kind"], "major_road"],
      "paint": {
        "line-color": "#46584E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.7, 16, 9]
      }
    },
    {
      "id": "roads-highway-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "highway"],
      "paint": {
        "line-color": "#4A3F22",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 16, 13]
      }
    },
    {
      "id": "roads-highway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "highway"],
      "paint": {
        "line-color": "#8A7134",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.7, 16, 11]
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["==", ["get", "kind"], "rail"],
      "paint": {
        "line-color": "#5A6A62",
        "line-width": 1.2,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": { "fill-color": "#1A2623", "fill-outline-color": "#26332F" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#2E3D37",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 12,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["literal", ["Noto Sans Regular"]],
        "text-size": 12
      },
      "paint": { "text-color": "#7FB6C9", "text-halo-color": "#0A1110", "text-halo-width": 1.5 }
    },
    {
      "id": "roads-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["literal", ["Noto Sans Regular"]],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": { "text-color": "#A9B8B2", "text-halo-color": "#0A1110", "text-halo-width": 1.5 }
    },
    {
      "id": "bus-stops",
      "type": "circle",
      "source": "protomaps",
      "source-layer": "pois",
      "minzoom": 14,
      "filter": ["==", ["get", "kind"], "bus_stop"],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 14, 2, 16, 4],
        "circle-color": "#3DDC97",
        "circle-stroke-color": "#0A1110",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "places-locality",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 8,
      "filter": ["==", ["get", "kind"], "locality"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["literal", ["Noto Sans Regular"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 20]
      },
      "paint": { "text-color": "#EAF2EE", "text-halo-color": "#0A1110", "text-halo-width": 2 }
    },
    {
      "id": "places-neighbourhood",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["neighbourhood", "macrohood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["literal", ["Noto Sans Regular"]],
        "text-size": 12
      },
      "paint": { "text-color": "#A9B8B2", "text-halo-color": "#0A1110", "text-halo-width": 1.5 }
    }
  ]
}
