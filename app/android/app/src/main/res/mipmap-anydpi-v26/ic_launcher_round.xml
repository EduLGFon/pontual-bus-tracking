<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: navy background sampled from the artwork edge,
     raster foreground generated from design/brand/app-icon.png (artwork inset
     to the 72dp safe zone). No monochrome layer: themed icons fall back to
     the standard icon until a vector monochrome of the new mark exists. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/pontual_icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
