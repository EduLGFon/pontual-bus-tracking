# Container environment for the Pontual API. Copy to server/.env (gitignored)
# or to a root-owned file such as /etc/pontual/env and point
# PONTUAL_ENV_FILE at it. Never bake these values into the image or keep
# them in compose.yaml.
#
# HOST, PORT, DATA_DIR and METRICS_PORT are set by compose.yaml; do not
# override them there.
APP_ENV=prod
# The bundled compose database is db:5432. The password must match
# PONTUAL_APP_PASSWORD in server/.env.db (or PONTUAL_DB_ENV_FILE).
# The API is unpublished; the tunnel reaches api:8080 on the internal edge
# network. Keep sslmode=require for the database connection.
DATABASE_URL=postgresql://pontual_app:change-me@db:5432/pontual?sslmode=require
# Exact browser origins allowed to call the API and open the stream.
ALLOWED_ORIGINS=https://pontual.spotnik.space
# The API is unpublished and only the cloudflared tunnel shares the
# internal edge network, so CF-Connecting-IP can be trusted.
TRUST_CLOUDFLARE=true
LOG_LEVEL=info
LEARNING_PRIVACY_MODE=all
# Empty in staging and prod.
LINES_JSON=[]
TEST_EASY_PUBLISH=false
