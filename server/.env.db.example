# Database-only secrets for the bundled PostgreSQL container and the one-shot
# dbmate migration. Copy to server/.env.db (gitignored) or point
# PONTUAL_DB_ENV_FILE at a root-owned file. Never commit real values.
#
# Generate each password with: openssl rand -hex 32
# Hex keeps the values URL-safe: compose builds the migrator URL from
# POSTGRES_PASSWORD, and server/.env embeds the same app password in
# DATABASE_URL. Keep PONTUAL_APP_PASSWORD identical in both files.
POSTGRES_PASSWORD=change-me
PONTUAL_APP_PASSWORD=change-me
